// Prisma schema for Anti-Stalking Personal Data Audit MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// NextAuth Models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Application Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")

  // Persona verification
  personaInquiryId String?   @map("persona_inquiry_id")
  personaVerifiedAt DateTime? @map("persona_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  scans    Scan[]

  @@map("users")
}

model Scan {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Input data (what we're scanning for)
  inputName  String  @map("input_name")
  inputEmail String  @map("input_email")
  inputPhone String? @map("input_phone")

  // Scan status
  // pending | queued | running | enriching | completed | failed
  status       String  @default("pending")
  progress     Int     @default(0) // 0-100
  currentStage String? @map("current_stage")
  errorMessage String? @map("error_message") @db.Text

  // SpiderFoot tracking
  spiderfootScanIds String[] @default([]) @map("spiderfoot_scan_ids")

  // Timing
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Results summary (computed after completion)
  riskScore        Int? @map("risk_score") // 0-100
  totalFindings    Int  @default(0) @map("total_findings")
  criticalFindings Int  @default(0) @map("critical_findings")
  highFindings     Int  @default(0) @map("high_findings")
  mediumFindings   Int  @default(0) @map("medium_findings")
  lowFindings      Int  @default(0) @map("low_findings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([userId])
  @@index([status])
  @@map("scans")
}

model Finding {
  id     String @id @default(cuid())
  scanId String @map("scan_id")

  // Classification
  // breach | social_media | location | phone | dark_web | professional | other
  category String
  // critical | high | medium | low
  severity String

  // Source
  sourceModule String? @map("source_module")
  sourceName   String? @map("source_name")

  // The finding itself
  title       String
  description String? @db.Text
  dataFound   Json?   @map("data_found")

  // For deduplication
  fingerprint    String?
  enrichmentPass Int     @default(1) @map("enrichment_pass")

  createdAt DateTime @default(now()) @map("created_at")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, fingerprint])
  @@index([scanId])
  @@index([severity])
  @@index([category])
  @@map("findings")
}

model Waitlist {
  id     String  @id @default(cuid())
  email  String  @unique
  scanId String? @map("scan_id")
  source String  @default("results_page")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}
