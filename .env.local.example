# Local Development Environment
# Copy to .env.local for local development with Docker Compose

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local PostgreSQL (from docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digitalbodyguard"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/digitalbodyguard"

# Auth
AUTH_SECRET="local-dev-secret-change-in-production"
NEXTAUTH_SECRET="local-dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Persona (use sandbox credentials from your Persona dashboard)
PERSONA_API_KEY="persona_sandbox_your-api-key-here"
NEXT_PUBLIC_PERSONA_TEMPLATE_ID="itmpl_your-template-id"
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID="env_your-environment-id"

# Local Redis (from docker-compose)
UPSTASH_REDIS_REST_URL="http://localhost:6379"
UPSTASH_REDIS_REST_TOKEN=""

# QStash (not needed locally - scans process inline)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Local SpiderFoot (from docker-compose)
SPIDERFOOT_API_URL="http://localhost:5001"
SPIDERFOOT_API_KEY=""
