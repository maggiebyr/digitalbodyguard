# Anti-Stalking Personal Data Audit MVP - Environment Variables
# Copy this to .env.local for local development or configure in your hosting platform

# ===========================================
# Application
# ===========================================
# Your app's public URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# Database (Supabase PostgreSQL)
# ===========================================
# Get these from: Supabase Dashboard > Settings > Database
# Use the "Connection pooling" URL for DATABASE_URL (Transaction mode)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the "Direct connection" URL for DIRECT_URL (for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ===========================================
# Auth (NextAuth.js v5)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-random-string-min-32-chars"
# Legacy env vars (NextAuth v5 uses AUTH_SECRET, but keep these for compatibility)
NEXTAUTH_SECRET="your-super-secret-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# Persona Identity Verification
# ===========================================
# Get these from: Persona Dashboard > Integration
# Use sandbox keys for development, production keys for prod
PERSONA_API_KEY="persona_sandbox_xxx"
NEXT_PUBLIC_PERSONA_TEMPLATE_ID="tmpl_xxx"
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID="env_xxx"
# Webhook secret for verifying Persona callbacks (optional but recommended)
PERSONA_WEBHOOK_SECRET="whsec_xxx"

# ===========================================
# Queue (Upstash Redis + QStash)
# ===========================================
# Get these from: Upstash Console > Redis
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"
# Get these from: Upstash Console > QStash
QSTASH_TOKEN="xxx"
QSTASH_CURRENT_SIGNING_KEY="sig_xxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxx"

# ===========================================
# SpiderFoot OSINT Engine
# ===========================================
# Your SpiderFoot HX instance URL (self-hosted or cloud)
# Leave empty to use demo mode
SPIDERFOOT_API_URL="https://your-spiderfoot.railway.app"
SPIDERFOOT_API_KEY="xxx"
